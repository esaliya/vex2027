int main() {
  // Initializing Robot Configuration. DO NOT REMOVE!
  vexcodeInit();

  // register event handlers
  Controller.ButtonRUp.pressed(onevent_ControllerButtonRUp_pressed_0);

  wait(15, msec);
  whenStarted1();
}
