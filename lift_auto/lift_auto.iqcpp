  // return 0;
}

//ESTOP code
void onevent_TouchLED_Pressed_0() 
{
  if (autonHasStarted) {
    autonTask.stop();
    Drivetrain.stop(coast);
    Lift.stop(coast);
    Intake.stop(coast);
    Ratchet.stop(coast);
    TouchLED.setColor(red);
    
   
    autonHasStarted = false; 
    return;
  }
  
  autonHasStarted = true;
  TouchLED.setColor(green);
  autonTask = task(autonomousSequence);
}

int main() {
  // Initializing Robot Configuration. DO NOT REMOVE!
  vexcodeInit();

  whenStarted1();

  // register event handlers
  TouchLED.pressed(onevent_TouchLED_Pressed_0);

  while (true) {
    wait(20, msec);
  }
}
