{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor LeftDriveSmart = motor(PORT9, 1, true);\nmotor RightDriveSmart = motor(PORT10, 1, false);\ndrivetrain Drivetrain = drivetrain(LeftDriveSmart, RightDriveSmart, 200, 173, 76, mm, 1);\ncontroller Controller = controller();\nmotor RatchetMotorA = motor(PORT12, true);\nmotor RatchetMotorB = motor(PORT7, false);\nmotor_group Ratchet = motor_group(RatchetMotorA, RatchetMotorB);\n\ntouchled TouchLED = touchled(PORT8);\nmotor Lift = motor(PORT1, false);\nmotor Intake = motor(PORT6, true);\nsonar Distance_Sensor = sonar(PORT2);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool DrivetrainLNeedsToBeStopped_Controller = true;\nbool DrivetrainRNeedsToBeStopped_Controller = true;\n\n// define a task that will handle monitoring inputs from Controller\nint rc_auto_loop_function_Controller() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      \n      // calculate the drivetrain motor velocities from the controller joystick axies\n      // left = AxisA + AxisC\n      // right = AxisA - AxisC\n      int drivetrainLeftSideSpeed = Controller.AxisA.position() + Controller.AxisC.position();\n      int drivetrainRightSideSpeed = Controller.AxisA.position() - Controller.AxisC.position();\n      \n      // check if the value is inside of the deadband range\n      if (drivetrainLeftSideSpeed < 5 && drivetrainLeftSideSpeed > -5) {\n        // check if the left motor has already been stopped\n        if (DrivetrainLNeedsToBeStopped_Controller) {\n          // stop the left drive motor\n          LeftDriveSmart.stop();\n          // tell the code that the left motor has been stopped\n          DrivetrainLNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the left motor nexttime the input is in the deadband range\n        DrivetrainLNeedsToBeStopped_Controller = true;\n      }\n      // check if the value is inside of the deadband range\n      if (drivetrainRightSideSpeed < 5 && drivetrainRightSideSpeed > -5) {\n        // check if the right motor has already been stopped\n        if (DrivetrainRNeedsToBeStopped_Controller) {\n          // stop the right drive motor\n          RightDriveSmart.stop();\n          // tell the code that the right motor has been stopped\n          DrivetrainRNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the right motor next time the input is in the deadband range\n        DrivetrainRNeedsToBeStopped_Controller = true;\n      }\n      \n      // only tell the left drive motor to spin if the values are not in the deadband range\n      if (DrivetrainLNeedsToBeStopped_Controller) {\n        LeftDriveSmart.setVelocity(drivetrainLeftSideSpeed, percent);\n        LeftDriveSmart.spin(forward);\n      }\n      // only tell the right drive motor to spin if the values are not in the deadband range\n      if (DrivetrainRNeedsToBeStopped_Controller) {\n        RightDriveSmart.setVelocity(drivetrainRightSideSpeed, percent);\n        RightDriveSmart.spin(forward);\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n// LED behavior:\n//   blue   - calibrating, touch ignored\n//   green  - ready, touch to start\n//   orange - running, touch to stop IMMEDIATELY (no start lockout)\n//   red    - finished: touch to start again\n//            canceled/failed: touch to lower the lift and recalibrate\n// The joystick drives the robot while it is ready (green) or stopped (red\n// after a cancel or failure), never during a run or while stopping.\n//\n// Joystick: the generated section above has its own joystick task (from the\n// Controller's drive setting in Devices). main() switches it off at startup\n// and reads the joystick itself, so nothing can drive the motors during a\n// run. Leave the generated section as VEXcode writes it.\n//\n// Run policy: near misses are counted and the run carries on, as the\n// original code did. The run stops only when it is cancelled, a turn runs\n// away or times out far from its target, or a drive stalls.\n\nconst int LIFT_SCORE_POS = 730;        // degrees\nconst int LIFT_TIMEOUT_MS = 3000;\nconst double LIFT_POS_TOLERANCE = 20;  // degrees (tune on robot)\nconst double DRIVE_VELOCITY = 20;     // percent\nconst int DRIVE_DEFAULT_TIMEOUT_MS = 3000;\nconst double DRIVE_WHEEL_TRAVEL_MM = 200.0; // same as drivetrain configuration\nconst double DRIVE_DISTANCE_TOLERANCE_MM = 10.0; // tune on robot\n// A drive that covers at least this fraction of its distance, but stops more\n// than DRIVE_DISTANCE_TOLERANCE_MM short, is counted as a miss and the run\n// carries on. Less than this counts as a stall and stops the run.\nconst double DRIVE_MIN_FRACTION = 0.5;\n// Right after a non-blocking motor command, isDone() can still report the\n// previous (finished) move, so wait this long before polling it.\nconst int MOTION_START_MS = 50;\nconst int PRESS_LOCKOUT_MS = 500;    // applies to START / RECALIBRATE only\nconst double JOYSTICK_DEADBAND = 5;\n\n// NOTE: These settings intentionally preserve your original turn controller.\nconst bool HEADING_REVERSED = false;\nconst double TURN_KP = 1.2;\nconst double TURN_MIN_SPEED = 14;\nconst double TURN_MAX_SPEED = 40;\nconst double TURN_TOLERANCE = 1.5;\n// Very small turns use half the turn size as their tolerance (never less than\n// this), so a 1-degree turn doesn't start out already \"settled\".\nconst double TURN_FINE_TOLERANCE = 0.5;\n// A turn that runs out of time within this many degrees of its target still\n// lets the run carry on (counted in timeoutCount).\nconst double TURN_ACCEPT_ERROR = 5;\nconst double TURN_KICK_SPEED = 30;\nconst int TURN_KICK_CYCLES = 1;      // one 10-ms control-loop iteration\nconst double TURN_KICK_MIN_ERROR = 8;\nconst int TURN_TIMEOUT_MS = 2500;\nconst double TURN_MAX_JUMP = 10;\nconst int TURN_GLITCH_ACCEPT = 5;\nconst double TURN_RUNAWAY_LIMIT = 30;\nconst bool TURN_DEBUG = true;\n\nenum RunState {\n  STATE_CALIBRATING,\n  STATE_READY,\n  STATE_RUNNING,\n  STATE_STOPPING,\n  STATE_STOPPED\n};\n\n// These variables are owned by main(), except where explicitly noted.\nRunState state = STATE_CALIBRATING;\ntimer sinceStateChange;\nbool lastTouchPressed = false;\nbool showHeading = false;\nbool leftManualActive = false;\nbool rightManualActive = false;\nbool stopWasRequested = false;\ndouble manualStopTime = 0;\nint loops = 0;\n\n// The worker writes the report fields. main() reads them ONLY after workerDone\n// has been published under runMutex, so it never reads a partial report.\ndouble splitTimes[3] = {0, 0, 0};\ndouble runEndTime = 0;\nconst char* failureStep = \"\"; // points to a string literal\nint turnCount = 0;\nint glitchCount = 0;\nint bailCount = 0;\nint timeoutCount = 0;\nint driveMissCount = 0; // drives that stopped short but not stalled\nint liftMissCount = 0;  // lift moves that ended away from their target\ndouble dbgMin = 0, dbgMax = 0;\nint dbgFlips = 0, dbgMs = 0;\ndouble targetHeading = 0;\n\n// All access to these handshake flags MUST be protected by runMutex.\n// The same mutex also serializes cancellation with every worker motor START.\nmutex runMutex;\nbool runRequested = false;\nbool cancelRequested = false;\nbool workerDone = false;\nbool workerSucceeded = false;\n\nvoid setState(RunState s) {\n  state = s;\n  sinceStateChange.clear();\n}\n\nbool isCanceled() {\n  runMutex.lock();\n  bool canceled = cancelRequested;\n  runMutex.unlock();\n  return canceled;\n}\n\nbool isWorkerDone() {\n  runMutex.lock();\n  bool done = workerDone;\n  runMutex.unlock();\n  return done;\n}\n\n// CALL ONLY WHILE HOLDING runMutex.\nvoid stopAllMotorsLocked() {\n  Drivetrain.stop(brake);\n  // Brake avoids indefinite powered holding if the lift is against a hard stop.\n  // Use hold instead if the physical lift needs active holding against gravity.\n  Lift.stop(brake);\n  Intake.stop(coast);\n  Ratchet.stop(coast);\n}\n\n// Main uses this to request an immediate stop. A worker cannot submit a later\n// motor command: every motor command START is serialized with this lock.\nvoid cancelRun() {\n  runMutex.lock();\n  cancelRequested = true;\n  stopAllMotorsLocked();\n  runMutex.unlock();\n}\n\n// Worker side of that rule: locks runMutex and returns true, unless the run\n// has been cancelled, in which case it leaves the mutex unlocked and returns\n// false. Every worker motor command goes through this; unlock after issuing.\nbool lockUnlessCanceled() {\n  runMutex.lock();\n  if (cancelRequested) {\n    runMutex.unlock();\n    return false;\n  }\n  return true;\n}\n\nbool waitCancelable(int milliseconds) {\n  timer t;\n  t.clear();\n  while (t.time(msec) < milliseconds) {\n    if (isCanceled()) return false;\n    wait(10, msec);\n  }\n  return !isCanceled();\n}\n\n// Moves the lift and waits for it. Returns false only if the run is\n// cancelled. A lift that ends more than LIFT_POS_TOLERANCE from its target\n// (jammed, or resting on something) is stopped and counted in liftMissCount,\n// and the run carries on, as the original code did.\nbool liftTo(double positionDeg) {\n  if (!lockUnlessCanceled()) return false;\n  Lift.setTimeout(LIFT_TIMEOUT_MS, msec);\n  Lift.spinToPosition(positionDeg, degrees, false);\n  runMutex.unlock();\n\n  timer t;\n  t.clear();\n  if (!waitCancelable(MOTION_START_MS)) return false;\n  while (!Lift.isDone() && t.time(msec) < LIFT_TIMEOUT_MS + 150) {\n    if (isCanceled()) return false;\n    wait(10, msec);\n  }\n  if (isCanceled()) return false;\n\n  if (fabs(Lift.position(degrees) - positionDeg) > LIFT_POS_TOLERANCE) {\n    liftMissCount++;\n    if (!lockUnlessCanceled()) return false;\n    Lift.stop(brake);\n    runMutex.unlock();\n  }\n  return true;\n}\n\n// Raises the lift to score, waits, and lowers it again. The lift is always\n// lowered, even if the raise missed. Returns false only if the run is\n// cancelled.\nbool scoreBeanbag() {\n  if (!liftTo(LIFT_SCORE_POS)) return false;\n  if (!waitCancelable(500)) return false;\n  return liftTo(0);\n}\n\n// Called only when the robot is stopped, from main().\nbool zeroHeading() {\n  BrainInertial.setRotation(0, degrees);\n  wait(100, msec);\n  int tries = 0;\n  while (tries < 40 && fabs(BrainInertial.rotation(degrees)) > 1.0) {\n    wait(25, msec);\n    tries++;\n  }\n  return !BrainInertial.isCalibrating() &&\n         fabs(BrainInertial.rotation(degrees)) <= 1.0;\n}\n\n// One rotation reading, signed so that a right turn is positive.\ndouble rawHeading() {\n  return (HEADING_REVERSED ? -1.0 : 1.0) * BrainInertial.rotation(degrees);\n}\n\n// The middle of three readings 5 ms apart, so a single glitched reading can't\n// become the reference that a turn is measured from.\ndouble steadyHeading() {\n  double a = rawHeading();\n  wait(5, msec);\n  double b = rawHeading();\n  wait(5, msec);\n  double c = rawHeading();\n  if ((a <= b && b <= c) || (c <= b && b <= a)) return b;\n  if ((b <= a && a <= c) || (c <= a && a <= b)) return a;\n  return c;\n}\n\n// Tolerance for a turn of 'deg' degrees: TURN_TOLERANCE normally, but half\n// the turn size for very small turns (never below TURN_FINE_TOLERANCE).\ndouble turnTolerance(double deg) {\n  double tolerance = fabs(deg) / 2;\n  if (tolerance > TURN_TOLERANCE) tolerance = TURN_TOLERANCE;\n  if (tolerance < TURN_FINE_TOLERANCE) tolerance = TURN_FINE_TOLERANCE;\n  return tolerance;\n}\n\n// Turns to targetHeading. Returns true when the turn settles, or when it runs\n// out of time within TURN_ACCEPT_ERROR of the target (counted in\n// timeoutCount), so the run carries on after a near miss. Returns false if\n// the turn runs away, times out far from the target, or the run is cancelled.\nbool turnToTarget(double tolerance) {\n  bool logThis = (turnCount == 0);\n  turnCount++;\n  timer t;\n  t.clear();\n  int settled = 0;\n  int lastDir = 0;\n  int badCount = 0;\n  int cycles = 0;\n  bool bailed = false;\n  double lastGood = steadyHeading();\n  double startError = fabs(targetHeading - lastGood);\n  double error = targetHeading - lastGood;\n  if (logThis) {\n    dbgMin = dbgMax = lastGood;\n    dbgFlips = 0;\n  }\n\n  while (t.time(msec) < TURN_TIMEOUT_MS && settled < 5) {\n    double raw = rawHeading();\n    double rot;\n    if (fabs(raw - lastGood) > TURN_MAX_JUMP && badCount < TURN_GLITCH_ACCEPT) {\n      badCount++;\n      glitchCount++;\n      rot = lastGood;\n    } else {\n      badCount = 0;\n      rot = raw;\n      lastGood = raw;\n    }\n\n    error = targetHeading - rot;\n    if (logThis) {\n      if (rot < dbgMin) dbgMin = rot;\n      if (rot > dbgMax) dbgMax = rot;\n    }\n    if (fabs(error) > startError + TURN_RUNAWAY_LIMIT) {\n      bailCount++;\n      bailed = true;\n      break;\n    }\n\n    if (!lockUnlessCanceled()) return false;\n    if (fabs(error) <= tolerance) {\n      Drivetrain.stop(brake);\n      settled++;\n    } else {\n      settled = 0;\n      int dir = (error > 0) ? 1 : -1;\n      if (logThis && lastDir != 0 && dir != lastDir) dbgFlips++;\n      lastDir = dir;\n      double speed = fabs(error) * TURN_KP;\n      if (speed < TURN_MIN_SPEED) speed = TURN_MIN_SPEED;\n      if (speed > TURN_MAX_SPEED) speed = TURN_MAX_SPEED;\n      if (cycles < TURN_KICK_CYCLES &&\n          fabs(error) > TURN_KICK_MIN_ERROR && speed < TURN_KICK_SPEED) {\n        speed = TURN_KICK_SPEED;\n      }\n      Drivetrain.setTurnVelocity(speed, percent);\n      Drivetrain.turn(dir > 0 ? right : left);\n    }\n    runMutex.unlock();\n    cycles++;\n    wait(10, msec);\n  }\n\n  if (logThis) dbgMs = (int)t.time(msec);\n  if (!lockUnlessCanceled()) return false;\n  Drivetrain.stop(brake);\n  runMutex.unlock();\n  if (settled >= 5) return true;\n  if (bailed) return false;\n  timeoutCount++;\n  return fabs(error) <= TURN_ACCEPT_ERROR;\n}\n\n// Makes the robot's current real heading the new reference, after it rams a\n// post and slides.\nvoid rebaseline() {\n  targetHeading = steadyHeading();\n}\n\nbool turnLeft(double deg) {\n  targetHeading -= deg;\n  return turnToTarget(turnTolerance(deg));\n}\n\nbool turnRight(double deg) {\n  targetHeading += deg;\n  return turnToTarget(turnTolerance(deg));\n}\n\n// Drives a distance and waits for it, using the non-blocking driveFor() and\n// polling isDone(). 'allowContact' is for timed pushes into a post: ending at\n// the timeout is expected there, so the distance isn't checked. Otherwise the\n// slower wheel's distance decides (the average could hide a stuck motor):\n//   - within DRIVE_DISTANCE_TOLERANCE_MM of the target: success\n//   - at least DRIVE_MIN_FRACTION of it: counted in driveMissCount, run goes on\n//   - less: a stall, returns false\n// Also returns false on bad arguments or when the run is cancelled.\nbool driveDistance(directionType dir, double distMm,\n                   int timeoutMs = DRIVE_DEFAULT_TIMEOUT_MS,\n                   double velocityPct = DRIVE_VELOCITY,\n                   bool allowContact = false) {\n  if (timeoutMs <= 0 || distMm <= 0 || velocityPct <= 0 || velocityPct > 100)\n    return false;\n\n  if (!lockUnlessCanceled()) return false;\n  double startL = LeftDriveSmart.position(degrees);\n  double startR = RightDriveSmart.position(degrees);\n  Drivetrain.setDriveVelocity(velocityPct, percent);\n  Drivetrain.setTimeout(timeoutMs, msec); // documented positive timeout\n  Drivetrain.driveFor(dir, distMm, mm, false);\n  runMutex.unlock();\n\n  timer t;\n  t.clear();\n  if (!waitCancelable(MOTION_START_MS)) return false;\n  while (!Drivetrain.isDone() && t.time(msec) < timeoutMs + 150) {\n    if (isCanceled()) return false;\n    wait(10, msec);\n  }\n  if (isCanceled()) return false;\n\n  // Past the time limit and still moving: don't leave the motors running.\n  if (!Drivetrain.isDone()) {\n    if (!lockUnlessCanceled()) return false;\n    Drivetrain.stop(brake);\n    runMutex.unlock();\n  }\n  if (allowContact) return true;\n\n  double distanceL =\n      fabs(LeftDriveSmart.position(degrees) - startL) * DRIVE_WHEEL_TRAVEL_MM / 360.0;\n  double distanceR =\n      fabs(RightDriveSmart.position(degrees) - startR) * DRIVE_WHEEL_TRAVEL_MM / 360.0;\n  double shortest = fmin(distanceL, distanceR);\n  if (shortest >= distMm - DRIVE_DISTANCE_TOLERANCE_MM) return true;\n  if (shortest >= distMm * DRIVE_MIN_FRACTION) {\n    driveMissCount++;\n    return true;\n  }\n  return false;\n}\n\n// Intakes are issued under the same cancellation/motor-command mutex.\nbool startIntake() {\n  if (!lockUnlessCanceled()) return false;\n  Intake.spin(forward);\n  runMutex.unlock();\n  return true;\n}\n\nbool stopIntake() {\n  if (!lockUnlessCanceled()) return false;\n  Intake.stop(coast);\n  runMutex.unlock();\n  return true;\n}\n\n// Failure labels are string literals, so the pointer remains valid.\nbool failStep(const char* label) {\n  if (!isCanceled()) failureStep = label;\n  return false;\n}\n\n// Same route, distances, speeds, waits, and commented-out third scoring steps\n// as the original. Near misses are counted and the run carries on; a step\n// returns false only for a runaway or far-off turn, a stalled drive, or a\n// cancel (see the run policy at the top). scoreBeanbag() and the intake\n// helpers fail only on a cancel, so they need no failure label.\nbool autonomousSequence() {\n  // BEANBAG 1\n  if (!turnLeft(15.35)) return failStep(\"BB1 turn\");\n  if (!driveDistance(forward, 95, 2000, DRIVE_VELOCITY, true))\n    return failStep(\"BB1 push\");\n  if (!scoreBeanbag()) return false;\n  splitTimes[0] = Brain.Timer.time(seconds);\n\n  // BEANBAG 2\n  if (!driveDistance(reverse, 40)) return failStep(\"BB2 back 40\");\n  rebaseline();  // robot slid on the post\n  if (!turnRight(17)) return failStep(\"BB2 turn 17\");\n  if (!startIntake()) return false;\n  if (!driveDistance(forward, 50, 2000, DRIVE_VELOCITY, true))\n    return failStep(\"BB2 push 50\");\n  if (!driveDistance(reverse, 75)) return failStep(\"BB2 back 75\");\n  if (!turnLeft(1)) return failStep(\"BB2 turn 1\");\n  if (!waitCancelable(1250)) return false;\n  if (!stopIntake()) return false;\n  if (!driveDistance(forward, 90, 2000, 15, true))\n    return failStep(\"BB2 push 90\");\n  if (!scoreBeanbag()) return false;\n  splitTimes[1] = Brain.Timer.time(seconds);\n\n  // BEANBAG 3 - left intentionally unchanged / incomplete as requested.\n  if (!driveDistance(reverse, 50)) return failStep(\"BB3 back 50\");\n  rebaseline();  // robot slid on the post\n  if (!turnRight(30)) return failStep(\"BB3 turn 30\");\n  if (!startIntake()) return false;\n  if (!driveDistance(forward, 110, 4000, DRIVE_VELOCITY, true))\n    return failStep(\"BB3 push 110\");\n  if (!driveDistance(reverse, 80, 4000)) return failStep(\"BB3 back 80\");\n  // turnLeft(30);\n  // wait(0.5,seconds);\n  // Intake.stop(coast);\n  // driveDistance(forward, 85, 2500);\n  // scoreBeanbag();\n  splitTimes[2] = Brain.Timer.time(seconds);\n\n  runEndTime = splitTimes[2];\n  return !isCanceled();\n}\n\n// Created ONCE from main(). Never forcibly kill a task while it holds a mutex.\n// Instead cancel cooperatively and stop the motors immediately in main().\nint autonomousWorker() {\n  while (true) {\n    runMutex.lock();\n    bool start = runRequested;\n    if (start) runRequested = false;\n    runMutex.unlock();\n\n    if (!start) {\n      wait(10, msec);\n      continue;\n    }\n\n    bool ok = autonomousSequence();\n    runMutex.lock();\n    stopAllMotorsLocked();\n    workerSucceeded = ok && !cancelRequested;\n    // On an automatic failure, record the time of failure.\n    if (!workerSucceeded && !cancelRequested)\n      runEndTime = Brain.Timer.time(seconds);\n    workerDone = true; // publish all completed worker-written report fields\n    runMutex.unlock();\n  }\n  return 0;\n}\n\nvoid printSplit(int row, const char* label, double t) {\n  Brain.Screen.setCursor(row, 1);\n  if (t > 0) Brain.Screen.print(\"%s %.2f s\", label, t);\n  else Brain.Screen.print(\"%s --\", label);\n}\n\nvoid showTimeReport(double total, bool success, bool manualStop) {\n  Brain.Screen.setFont(mono15);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Total: %.2f s\", total);\n  printSplit(2, \"BB1:\", splitTimes[0]);\n  printSplit(3, \"BB2:\", splitTimes[1]);\n  printSplit(4, \"BB3:\", splitTimes[2]);\n  if (TURN_DEBUG) {\n    Brain.Screen.setCursor(5, 1);\n    Brain.Screen.print(\"T1:%.0f/%.0f %d\", dbgMin, dbgMax, dbgMs);\n    // f = direction flips in turn 1, g = sensor glitches ignored,\n    // b = runaway turns, t = turn timeouts, d = short drives, l = lift misses\n    Brain.Screen.setCursor(6, 1);\n    Brain.Screen.print(\"f%d g%d b%d t%d d%d l%d\", dbgFlips, glitchCount,\n                       bailCount, timeoutCount, driveMissCount, liftMissCount);\n  }\n  Brain.Screen.setCursor(7, 1);\n  if (manualStop) Brain.Screen.print(\"CANCELLED\");\n  else if (!success) Brain.Screen.print(\"FAIL: %s\", failureStep);\n  else Brain.Screen.print(\"DONE\");\n}\n\nvoid showReadyScreen() {\n  Brain.Screen.setFont(mono20);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Batt: %d%%\", (int)Brain.Battery.capacity(percent));\n}\n\nvoid becomeReady() {\n  showReadyScreen();\n  showHeading = true;\n  leftManualActive = rightManualActive = false;\n  TouchLED.setColor(green);\n  setState(STATE_READY);\n  // Ignore any touch held through the blocking calibration procedure.\n  lastTouchPressed = TouchLED.pressing();\n}\n\nvoid showCalibrationFailure() {\n  showHeading = false;\n  Brain.Screen.setFont(mono20);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Inertial error\");\n  Brain.Screen.setCursor(2, 1);\n  Brain.Screen.print(\"Press to retry\");\n  TouchLED.setColor(red);\n  setState(STATE_STOPPED);\n  lastTouchPressed = TouchLED.pressing();\n}\n\n// This is called from main only when no autonomous run is in flight.\nvoid recalibrate() {\n  setState(STATE_CALIBRATING);\n  leftManualActive = rightManualActive = false;\n  Drivetrain.stop(brake);\n  showHeading = false;\n  TouchLED.setColor(blue);\n  // A cancelled run leaves the lift braked wherever it stopped. Lower it now,\n  // before the robot has to stay still for calibration. The lift's timeout\n  // (LIFT_TIMEOUT_MS) stops this if the lift is jammed.\n  if (Lift.position(degrees) > LIFT_POS_TOLERANCE) {\n    Lift.spinToPosition(0, degrees, true);\n  }\n  wait(200, msec);\n  BrainInertial.calibrate();\n  while (BrainInertial.isCalibrating()) wait(25, msec);\n  if (!zeroHeading()) {\n    showCalibrationFailure();\n    return;\n  }\n  becomeReady();\n}\n\n// The joystick drives ONLY from main, in STATE_READY or STATE_STOPPED. The\n// generated joystick task is switched off at startup, so nothing can drive\n// the motors during a run.\nvoid manualMotor(motor& m, double speed, bool& previouslyActive) {\n  if (fabs(speed) < JOYSTICK_DEADBAND) {\n    if (previouslyActive) m.stop(brake);\n    previouslyActive = false;\n  } else {\n    m.spin(speed >= 0 ? forward : reverse, fabs(speed), percent);\n    previouslyActive = true;\n  }\n}\n\nvoid updateManualDrive() {\n  double l = Controller.AxisA.position() + Controller.AxisC.position();\n  double r = Controller.AxisA.position() - Controller.AxisC.position();\n  double maximum = fmax(fabs(l), fabs(r));\n  if (maximum > 100.0) {\n    l *= 100.0 / maximum;\n    r *= 100.0 / maximum;\n  }\n  manualMotor(LeftDriveSmart, l, leftManualActive);\n  manualMotor(RightDriveSmart, r, rightManualActive);\n}\n\nvoid startRun() {\n  // main is the only thread that can operate the joystick; it stops here.\n  Drivetrain.stop(brake);\n  leftManualActive = rightManualActive = false;\n  showHeading = false;\n  TouchLED.setColor(orange);\n\n  // This occurs BEFORE the worker starts, so resets do not race its writes.\n  splitTimes[0] = splitTimes[1] = splitTimes[2] = 0;\n  turnCount = glitchCount = bailCount = timeoutCount = 0;\n  driveMissCount = liftMissCount = 0;\n  dbgMin = dbgMax = 0;\n  dbgFlips = dbgMs = 0;\n  runEndTime = 0;\n  failureStep = \"\";\n  targetHeading = 0;\n  stopWasRequested = false;\n  manualStopTime = 0;\n\n  if (!zeroHeading()) {\n    showCalibrationFailure();\n    return;\n  }\n  Brain.Timer.clear();\n  setState(STATE_RUNNING);\n  lastTouchPressed = TouchLED.pressing();\n\n  runMutex.lock();\n  cancelRequested = false;\n  workerSucceeded = false;\n  workerDone = false;\n  runRequested = true;\n  runMutex.unlock();\n}\n\nvoid requestStop() {\n  if (state != STATE_RUNNING) return;\n  manualStopTime = Brain.Timer.time(seconds);\n  stopWasRequested = true;\n  setState(STATE_STOPPING);\n  cancelRun(); // stops motors now, even if worker is inside a drive/lift command\n}\n\nvoid finishRun() {\n  // Must only be called after isWorkerDone(); all worker data is now stable.\n  bool success;\n  runMutex.lock();\n  success = workerSucceeded;\n  runMutex.unlock();\n  showHeading = false;\n  double total = stopWasRequested ? manualStopTime : runEndTime;\n  showTimeReport(total, success, stopWasRequested);\n  TouchLED.setColor(red);\n  leftManualActive = rightManualActive = false;\n  // A naturally completed run can be restarted immediately after lockout.\n  // A canceled or failed run must be recalibrated first.\n  setState((success && !stopWasRequested) ? STATE_READY : STATE_STOPPED);\n}\n\nvoid configureRobot() {\n  LeftDriveSmart.setMaxTorque(100, percent);\n  RightDriveSmart.setMaxTorque(100, percent);\n  Drivetrain.setStopping(brake);\n  Lift.setStopping(brake);\n  Intake.setStopping(coast);\n  Ratchet.setStopping(coast);\n  Drivetrain.setDriveVelocity(DRIVE_VELOCITY, percent);\n  Drivetrain.setTurnVelocity(50, percent);\n  Ratchet.setVelocity(100, percent);\n  Ratchet.setMaxTorque(100, percent);\n  Lift.setVelocity(100, percent);\n  Lift.setMaxTorque(100, percent);\n  Lift.setPosition(0, degrees); // assumes the physical lift starts at zero\n  Lift.setTimeout(LIFT_TIMEOUT_MS, msec);\n  Intake.setVelocity(100, percent);\n  Intake.setMaxTorque(100, percent);\n}\n\nint main() {\n  // Switch off the generated joystick task first: main() reads the joystick\n  // itself, and only while no run is in flight.\n  RemoteControlCodeEnabled = false;\n  vexcodeInit();\n  configureRobot();\n  // Create the worker after hardware configuration (not during globals init).\n  task worker(autonomousWorker);\n  recalibrate();\n\n  while (true) {\n    if ((state == STATE_RUNNING || state == STATE_STOPPING) &&\n        isWorkerDone()) {\n      finishRun();\n    }\n\n    // Poll instead of a concurrent TouchLED callback: there is no shared\n    // pressPending flag and no read/clear race. Detect one event per press.\n    bool pressedNow = TouchLED.pressing();\n    bool newPress = pressedNow && !lastTouchPressed;\n    lastTouchPressed = pressedNow;\n    if (newPress) {\n      if (state == STATE_RUNNING) {\n        requestStop(); // No lockout: emergency stop always takes priority.\n      } else if (sinceStateChange.time(msec) >= PRESS_LOCKOUT_MS) {\n        if (state == STATE_READY) startRun();\n        else if (state == STATE_STOPPED) recalibrate();\n      }\n    }\n\n    // STOPPED is after the worker has finished, so the driver can bring the\n    // robot back after a cancel or failure before recalibrating.\n    if (state == STATE_READY || state == STATE_STOPPED) updateManualDrive();\n\n    if (showHeading && (loops % 5 == 0)) {\n      Brain.Screen.setCursor(2, 1);\n      Brain.Screen.print(\"Rot: %.1f   \", BrainInertial.rotation(degrees));\n    }\n    loops++;\n    wait(20, msec);\n  }\n}\n","textLanguage":"cpp","robotConfig":[{"port":[9,10,0],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"rev","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22},{"port":[12,7],"name":"Ratchet","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[8],"name":"TouchLED","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[1],"name":"Lift","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"Intake","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"Distance_Sensor","customName":true,"deviceType":"Distance","deviceClass":"sonar","setting":{},"triportSourcePort":22}],"slot":1,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}