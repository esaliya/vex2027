#pragma region VEXcode Generated Robot Configuration
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>
#include <string.h>

#include "vex.h"

using namespace vex;

brain Brain;

#define waitUntil(condition)                                                   \
  do {                                                                         \
    wait(5, msec);                                                             \
  } while (!(condition))

#define repeat(iterations)                                                     \
  for (int iterator = 0; iterator < iterations; iterator++)

inertial BrainInertial = inertial();
motor LeftDriveSmart = motor(PORT9, 1, true);
motor RightDriveSmart = motor(PORT10, 1, false);
drivetrain Drivetrain = drivetrain(LeftDriveSmart, RightDriveSmart, 200, 173, 76, mm, 1);
controller Controller = controller();
motor RatchetMotorA = motor(PORT12, true);
motor RatchetMotorB = motor(PORT7, false);
motor_group Ratchet = motor_group(RatchetMotorA, RatchetMotorB);
touchled TouchLED = touchled(PORT8);
motor Lift = motor(PORT1, false);
motor Intake = motor(PORT6, true);
sonar Distance_Sensor = sonar(PORT2);

void initializeRandomSeed(){
  wait(100,msec);
  double xAxis = BrainInertial.acceleration(xaxis) * 1000;
  double yAxis = BrainInertial.acceleration(yaxis) * 1000;
  double zAxis = BrainInertial.acceleration(zaxis) * 1000;
  int seed = int(xAxis + yAxis + zAxis);
  srand(seed); 
}

void vexcodeInit() {
  initializeRandomSeed(); 
}

bool RemoteControlCodeEnabled = true;
bool DrivetrainLNeedsToBeStopped_Controller = true;
bool DrivetrainRNeedsToBeStopped_Controller = true;

int rc_auto_loop_function_Controller() {
  while(true) {
    if(RemoteControlCodeEnabled) {
      int drivetrainLeftSideSpeed = Controller.AxisA.position() + Controller.AxisC.position();
      int drivetrainRightSideSpeed = Controller.AxisA.position() - Controller.AxisC.position();
      
      if (drivetrainLeftSideSpeed < 5 && drivetrainLeftSideSpeed > -5) {
        if (DrivetrainLNeedsToBeStopped_Controller) {
          LeftDriveSmart.stop();
          DrivetrainLNeedsToBeStopped_Controller = false;
        }
      } else {
        DrivetrainLNeedsToBeStopped_Controller = true;
      }
      if (drivetrainRightSideSpeed < 5 && drivetrainRightSideSpeed > -5) {
        if (DrivetrainRNeedsToBeStopped_Controller) {
          RightDriveSmart.stop();
          DrivetrainRNeedsToBeStopped_Controller = false;
        }
      } else {
        DrivetrainRNeedsToBeStopped_Controller = true;
      }
      
      if (DrivetrainLNeedsToBeStopped_Controller) {
        LeftDriveSmart.setVelocity(drivetrainLeftSideSpeed, percent);
        LeftDriveSmart.spin(forward);
      }
      if (DrivetrainRNeedsToBeStopped_Controller) {
        RightDriveSmart.setVelocity(drivetrainRightSideSpeed, percent);
        RightDriveSmart.spin(forward);
      }
    }
    wait(20, msec);
  }
  return 0;
}

task rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);
#pragma endregion VEXcode Generated Robot Configuration

#include "vex.h"
  
using namespace vex;

float myVariable;
bool autonHasStarted = false;

int autonomousSequence();
task autonTask;

void endAndReportTime() {
  double finalTime = Brain.Timer.time(seconds);
  Drivetrain.stop(coast);
  Lift.stop(coast);
  Intake.stop(coast);
  Ratchet.stop(coast);
  Brain.Screen.clearScreen();
  Brain.Screen.setCursor(1, 1);
  Brain.Screen.print("Elapsed Time:");
  Brain.Screen.setCursor(2, 1);
  Brain.Screen.print("%.2f sec", finalTime);
}

int whenStarted1() {
  Drivetrain.setStopping(coast);
  Lift.setStopping(coast);
  Intake.setStopping(coast);
  Ratchet.setStopping(coast);
  
  Drivetrain.setDriveVelocity(20.0, percent);
  Drivetrain.setTurnVelocity(50.0, percent);
  Ratchet.setVelocity(100.0, percent);
  Ratchet.setMaxTorque(100.0, percent);
  Lift.setVelocity(100.0, percent);
  Lift.setMaxTorque(100.0, percent);
  Lift.setPosition(0,degrees);
  Intake.setVelocity(100.0, percent);
  Intake.setMaxTorque(100.0, percent);
  Ratchet.spinToPosition(0.0, degrees, false);
  TouchLED.setColor(red);
  return 0;
}

int autonomousSequence() 
{
  Drivetrain.setTimeout(2,seconds);
  Drivetrain.turnFor(left,12.7,degrees,true);
  Drivetrain.driveFor(forward,95,mm,true);
  Drivetrain.setTimeout(0,seconds);
  Lift.spinToPosition(730,degrees,true);
  wait(0.5,seconds);
  Lift.spinToPosition(0,degrees, true);

  Drivetrain.driveFor(reverse,40,mm,true);
  Drivetrain.turnFor(right,12,degrees,true);
  Intake.spin(forward);
  Drivetrain.setTimeout(2,seconds);
  Drivetrain.driveFor(forward,50,mm,true);
  Drivetrain.setTimeout(0,seconds);
  Drivetrain.driveFor(reverse,75,mm,true);
  Drivetrain.turnFor(left, 12,degrees,true);
  wait(1.25,seconds);
  Intake.stop(coast);
  Drivetrain.setTimeout(2,seconds);
  Drivetrain.setDriveVelocity(15,percent);
  Drivetrain.driveFor(forward,90,mm,true);
  Drivetrain.setDriveVelocity(20,percent);
  Drivetrain.setTimeout (0,seconds);
  Lift.spinToPosition(730,degrees,true);
  wait(0.5,seconds);
  Lift.spinToPosition(0,degrees, true);

  Drivetrain.driveFor(reverse,50,mm,true);
  Drivetrain.turnFor(right,17,degrees,true);
  Intake.spin(forward);
  Drivetrain.setTimeout(4,seconds);
  Drivetrain.driveFor(forward,80,mm,true);
  Drivetrain.driveFor(reverse,80,mm,true);
  Drivetrain.setTimeout(0,seconds);
  Drivetrain.turnFor(left,17,degrees,true);
  wait(0.5,seconds);
  Intake.stop(coast);
  Drivetrain.setTimeout(3,seconds);
  Drivetrain.driveFor(forward,85,mm,true);
  Drivetrain.setTimeout(0,seconds);
  Lift.spinToPosition(730,degrees,true);
  wait(0.5,seconds);
  Lift.spinToPosition(0,degrees, true);

  endAndReportTime();
  autonHasStarted = false;
  TouchLED.setColor(red);
  return 0;
}

void onevent_TouchLED_Pressed_0() 
{
  if (autonHasStarted) {
    autonTask.stop();
    endAndReportTime();
    TouchLED.setColor(red);
    autonHasStarted = false; 
    return;
  }
  
  Brain.Timer.clear();
  autonHasStarted = true;
  TouchLED.setColor(green);
  autonTask = task(autonomousSequence);
}

int main() {
  vexcodeInit();
  whenStarted1();
  TouchLED.pressed(onevent_TouchLED_Pressed_0);
  while (true) {
    wait(20, msec);
  }
}
