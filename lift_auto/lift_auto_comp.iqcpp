{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor LeftDriveSmart = motor(PORT9, 1, true);\nmotor RightDriveSmart = motor(PORT10, 1, false);\ndrivetrain Drivetrain = drivetrain(LeftDriveSmart, RightDriveSmart, 200, 173, 76, mm, 1);\ncontroller Controller = controller();\nmotor RatchetMotorA = motor(PORT12, true);\nmotor RatchetMotorB = motor(PORT7, false);\nmotor_group Ratchet = motor_group(RatchetMotorA, RatchetMotorB);\n\ntouchled TouchLED = touchled(PORT8);\nmotor Lift = motor(PORT1, false);\nmotor Intake = motor(PORT6, true);\nsonar Distance_Sensor = sonar(PORT2);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool DrivetrainLNeedsToBeStopped_Controller = true;\nbool DrivetrainRNeedsToBeStopped_Controller = true;\n\n// define a task that will handle monitoring inputs from Controller\nint rc_auto_loop_function_Controller() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      \n      // calculate the drivetrain motor velocities from the controller joystick axies\n      // left = AxisA + AxisC\n      // right = AxisA - AxisC\n      int drivetrainLeftSideSpeed = Controller.AxisA.position() + Controller.AxisC.position();\n      int drivetrainRightSideSpeed = Controller.AxisA.position() - Controller.AxisC.position();\n      \n      // check if the value is inside of the deadband range\n      if (drivetrainLeftSideSpeed < 5 && drivetrainLeftSideSpeed > -5) {\n        // check if the left motor has already been stopped\n        if (DrivetrainLNeedsToBeStopped_Controller) {\n          // stop the left drive motor\n          LeftDriveSmart.stop();\n          // tell the code that the left motor has been stopped\n          DrivetrainLNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the left motor nexttime the input is in the deadband range\n        DrivetrainLNeedsToBeStopped_Controller = true;\n      }\n      // check if the value is inside of the deadband range\n      if (drivetrainRightSideSpeed < 5 && drivetrainRightSideSpeed > -5) {\n        // check if the right motor has already been stopped\n        if (DrivetrainRNeedsToBeStopped_Controller) {\n          // stop the right drive motor\n          RightDriveSmart.stop();\n          // tell the code that the right motor has been stopped\n          DrivetrainRNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the right motor next time the input is in the deadband range\n        DrivetrainRNeedsToBeStopped_Controller = true;\n      }\n      \n      // only tell the left drive motor to spin if the values are not in the deadband range\n      if (DrivetrainLNeedsToBeStopped_Controller) {\n        LeftDriveSmart.setVelocity(drivetrainLeftSideSpeed, percent);\n        LeftDriveSmart.spin(forward);\n      }\n      // only tell the right drive motor to spin if the values are not in the deadband range\n      if (DrivetrainRNeedsToBeStopped_Controller) {\n        RightDriveSmart.setVelocity(drivetrainRightSideSpeed, percent);\n        RightDriveSmart.spin(forward);\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n#include \"vex.h\"\n  \nusing namespace vex;\n\n// TouchLED colors and what a press does:\n//   blue   = calibrating (presses are ignored)\n//   green  = ready: press to start the run\n//   orange = running: press to stop the run\n//   red    = finished or stopped: press to recalibrate (blue, then green)\n\nconst int LIFT_SCORE_POS = 730;     // lift position for scoring (degrees)\nconst int LIFT_TIMEOUT_MS = 3000;   // a lift move gives up after this long (jammed lift)\nconst double DRIVE_VELOCITY = 20;   // normal drive speed (%)\n\n// Presses are ignored for this long after the robot changes state, so a double\n// tap or a press during calibration can't start or stop a run by accident.\nconst int PRESS_LOCKOUT_MS = 500;\n\nenum RunState { STATE_CALIBRATING, STATE_READY, STATE_RUNNING, STATE_STOPPED };\nRunState state = STATE_CALIBRATING; // only main() changes this\ntimer sinceStateChange;             // time since the last state change\nbool pressPending = false;          // set by the TouchLED event, handled by main()\nbool autonDone = false;             // set by the autonomous task when it finishes\ndouble runEndTime = 0;              // run time when the run finished or was stopped\n\nbool showHeading = false;           // live heading readout while waiting\ndouble splitTimes[3] = {0, 0, 0};   // time each beanbag was finished\ndouble targetHeading = 0;           // total intended turn since start (degrees, right = positive)\n\n// Set true if the sensor counts the opposite way (see the Rot readout).\nconst bool HEADING_REVERSED = false;\n\n// Turn tuning: speed (%) = error * KP, limited to MIN..MAX.\nconst double TURN_KP = 1.2;\nconst double TURN_MIN_SPEED = 14;\nconst double TURN_MAX_SPEED = 40;\nconst double TURN_TOLERANCE = 1.5;     // degrees\nconst double TURN_KICK_SPEED = 30;     // extra push at the start of a big turn\nconst int TURN_KICK_MS = 120;          // how long the push lasts\nconst double TURN_KICK_MIN_ERROR = 8;  // only kick if the turn is at least this big\nconst int TURN_TIMEOUT_MS = 2500;\n\n// Glitch filter: a reading that jumps more than MAX_JUMP degrees in one 10 ms\n// step is treated as a sensor glitch and ignored. If the jump persists for\n// GLITCH_ACCEPT steps in a row, it is accepted as real.\nconst double TURN_MAX_JUMP = 10;\nconst int TURN_GLITCH_ACCEPT = 5;\n// A turn stops if the error grows this many degrees beyond where it started.\nconst double TURN_RUNAWAY_LIMIT = 30;\n\n// When true, the time report shows details of the first turn of the run:\n// lowest and highest rotation reached, time taken, direction changes, plus\n// whole-run counts of sensor glitches, runaway turns and timed-out turns.\nconst bool TURN_DEBUG = true;\nint turnCount = 0;\nint glitchCount = 0;   // sensor readings ignored as impossible jumps (whole run)\nint bailCount = 0;     // turns stopped early for running away (whole run)\nint timeoutCount = 0;  // turns that ran out of time before settling (whole run)\ndouble dbgMin = 0, dbgMax = 0;\nint dbgFlips = 0, dbgMs = 0;\n\nint autonomousSequence();\ntask autonTask;\n\nvoid setState(RunState s) {\n  state = s;\n  sinceStateChange.clear();\n}\n\n// Lifts to the scoring position, then back down. Each move gives up after\n// LIFT_TIMEOUT_MS (set in whenStarted1), so a jammed lift can't hang the run.\nvoid scoreBeanbag() {\n  Lift.spinToPosition(LIFT_SCORE_POS, degrees, true);\n  wait(0.5, seconds);\n  Lift.spinToPosition(0, degrees, true);\n}\n\n// One rotation reading, in turn direction (right = positive).\ndouble rawHeading() {\n  return (HEADING_REVERSED ? -1.0 : 1.0) * BrainInertial.rotation(degrees);\n}\n\n// The middle of three readings 5 ms apart, so one glitched reading can't\n// become the reference that a turn is measured from.\ndouble steadyHeading() {\n  double a = rawHeading();\n  wait(5, msec);\n  double b = rawHeading();\n  wait(5, msec);\n  double c = rawHeading();\n  if ((a <= b && b <= c) || (c <= b && b <= a)) return b;\n  if ((b <= a && a <= c) || (c <= a && a <= b)) return a;\n  return c;\n}\n\n// Sets the sensor's rotation to 0 and waits until it reports it.\n// Rotation is continuous (no 0/360 wrap-around).\nvoid zeroHeading() {\n  BrainInertial.setRotation(0, degrees);\n  wait(100, msec);\n  int tries = 0;\n  while (tries < 40 && fabs(BrainInertial.rotation(degrees)) > 1.0) {\n    wait(25, msec);\n    tries++;\n  }\n}\n\n// Turns until the sensor's rotation matches targetHeading, slowing as it\n// gets close. Ignores impossible sensor jumps, stops if the turn runs away,\n// and gives up at the timeout.\nvoid turnToTarget() {\n  bool logThis = (turnCount == 0);\n  turnCount++;\n  int settled = 0;\n  int lastDir = 0;\n  int badCount = 0;\n  bool bailed = false;\n  double lastGood = steadyHeading();\n  double startError = fabs(targetHeading - lastGood);\n  if (logThis) {\n    dbgMin = dbgMax = lastGood;\n    dbgFlips = 0;\n  }\n  timer t;\n  t.clear();\n  while (t.time(msec) < TURN_TIMEOUT_MS && settled < 5) {\n    double raw = rawHeading();\n    double rot;\n    if (fabs(raw - lastGood) > TURN_MAX_JUMP && badCount < TURN_GLITCH_ACCEPT) {\n      badCount++;\n      glitchCount++;\n      rot = lastGood;\n    } else {\n      badCount = 0;\n      rot = raw;\n      lastGood = raw;\n    }\n    double error = targetHeading - rot;\n    if (logThis) {\n      if (rot < dbgMin) dbgMin = rot;\n      if (rot > dbgMax) dbgMax = rot;\n    }\n    if (fabs(error) > startError + TURN_RUNAWAY_LIMIT) {\n      bailCount++;\n      bailed = true;\n      break;\n    }\n    if (fabs(error) <= TURN_TOLERANCE) {\n      Drivetrain.stop();\n      settled++;\n    } else {\n      settled = 0;\n      int dir = (error > 0) ? 1 : -1;\n      if (logThis && lastDir != 0 && dir != lastDir) dbgFlips++;\n      lastDir = dir;\n      double speed = fabs(error) * TURN_KP;\n      if (speed < TURN_MIN_SPEED) speed = TURN_MIN_SPEED;\n      if (speed > TURN_MAX_SPEED) speed = TURN_MAX_SPEED;\n      if (t.time(msec) < TURN_KICK_MS && fabs(error) > TURN_KICK_MIN_ERROR && speed < TURN_KICK_SPEED) {\n        speed = TURN_KICK_SPEED;\n      }\n      Drivetrain.setTurnVelocity(speed, percent);\n      if (dir > 0) {\n        Drivetrain.turn(right);\n      } else {\n        Drivetrain.turn(left);\n      }\n    }\n    wait(10, msec);\n  }\n  Drivetrain.stop();\n  if (settled < 5 && !bailed) timeoutCount++;\n  if (logThis) dbgMs = (int)t.time(msec);\n}\n\n// Makes the robot's current real heading the new reference. Call it after the\n// robot rams a post and slides, so the next turn is measured from where the\n// robot actually ended up instead of snapping back to the planned heading.\nvoid rebaseline() {\n  targetHeading = steadyHeading();\n}\n\n// Turn by an angle relative to the current direction.\nvoid turnLeft(double deg) {\n  targetHeading -= deg;\n  turnToTarget();\n}\n\nvoid turnRight(double deg) {\n  targetHeading += deg;\n  turnToTarget();\n}\n\n// Drives a distance. timeoutMs > 0 makes the robot give up after that long,\n// for pushing against a post; 0 means no time limit. Speed and timeout are\n// set on every call, so a stopped run can't leave them changed for the next.\nvoid driveDistance(directionType dir, double distMm, int timeoutMs = 0, double velocityPct = DRIVE_VELOCITY) {\n  Drivetrain.setDriveVelocity(velocityPct, percent);\n  Drivetrain.setTimeout(timeoutMs, msec);\n  Drivetrain.driveFor(dir, distMm, mm, true);\n}\n\nvoid printSplit(int row, const char* label, double t) {\n  Brain.Screen.setCursor(row, 1);\n  if (t > 0) {\n    Brain.Screen.print(\"%s %.2f s\", label, t);\n  } else {\n    Brain.Screen.print(\"%s --\", label);\n  }\n}\n\n// Stops everything, gives control back to the joysticks, shows the time report.\nvoid endAndReportTime() {\n  Drivetrain.stop(coast);\n  Lift.stop(coast);\n  Intake.stop(coast);\n  Ratchet.stop(coast);\n  RemoteControlCodeEnabled = true;\n\n  // The default font only fits 5 rows; mono15 fits 7 rows of 20 characters.\n  Brain.Screen.setFont(mono15);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Total: %.2f s\", runEndTime);\n  printSplit(2, \"BB1:\", splitTimes[0]);\n  printSplit(3, \"BB2:\", splitTimes[1]);\n  printSplit(4, \"BB3:\", splitTimes[2]);\n  if (TURN_DEBUG) {\n    Brain.Screen.setCursor(5, 1);\n    Brain.Screen.print(\"T1:%.0f/%.0f %d\", dbgMin, dbgMax, dbgMs);\n    Brain.Screen.setCursor(6, 1);\n    Brain.Screen.print(\"f%d g%d b%d t%d\", dbgFlips, glitchCount, bailCount, timeoutCount);\n  }\n}\n\n// Shows the ready screen with the battery level.\nvoid showReadyScreen() {\n  Brain.Screen.setFont(mono20);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Batt: %d%%\", (int)Brain.Battery.capacity(percent));\n}\n\n// Calibrates the inertial sensor: blue while calibrating, green when ready.\n// The joystick is off meanwhile, because the robot must stay still.\nvoid recalibrate() {\n  setState(STATE_CALIBRATING);\n  RemoteControlCodeEnabled = false;\n  Drivetrain.stop();\n  showHeading = false;\n  TouchLED.setColor(blue);\n  wait(200, msec);\n  BrainInertial.calibrate();\n  while (BrainInertial.isCalibrating()) {\n    wait(25, msec);\n  }\n  zeroHeading();\n  showReadyScreen();\n  showHeading = true;\n  RemoteControlCodeEnabled = true;\n  TouchLED.setColor(green);\n  setState(STATE_READY);\n}\n\n// Starts a run: orange LED, zero the heading, start the autonomous task.\nvoid startRun() {\n  RemoteControlCodeEnabled = false;\n  Drivetrain.stop();\n  TouchLED.setColor(orange);\n  showHeading = false;\n  splitTimes[0] = splitTimes[1] = splitTimes[2] = 0;\n  turnCount = glitchCount = bailCount = timeoutCount = 0;\n  dbgMin = dbgMax = 0;\n  dbgFlips = dbgMs = 0;\n  autonDone = false;\n  runEndTime = 0;\n  zeroHeading();\n  // Measure turns from where the sensor really is, even if zeroing didn't take.\n  targetHeading = steadyHeading();\n  Brain.Timer.clear();\n  setState(STATE_RUNNING);\n  autonTask = task(autonomousSequence);\n}\n\n// Ends the run (stopping the autonomous task if it is still going), shows\n// the time report and turns the LED red.\nvoid endRun() {\n  if (!autonDone) {\n    autonTask.stop();\n    runEndTime = Brain.Timer.time(seconds);\n  }\n  endAndReportTime();\n  TouchLED.setColor(red);\n  setState(STATE_STOPPED);\n}\n\n// Startup settings.\nint whenStarted1() {\n  LeftDriveSmart.setMaxTorque(100, percent);\n  RightDriveSmart.setMaxTorque(100, percent);\n  Drivetrain.setStopping(brake);\n  Lift.setStopping(coast);\n  Intake.setStopping(coast);\n  Ratchet.setStopping(coast);\n\n  Drivetrain.setDriveVelocity(DRIVE_VELOCITY, percent);\n  Drivetrain.setTurnVelocity(50.0, percent);\n  Ratchet.setVelocity(100.0, percent);\n  Ratchet.setMaxTorque(100.0, percent);\n  Lift.setVelocity(100.0, percent);\n  Lift.setMaxTorque(100.0, percent);\n  Lift.setPosition(0,degrees);\n  Lift.setTimeout(LIFT_TIMEOUT_MS, msec);\n  Intake.setVelocity(100.0, percent);\n  Intake.setMaxTorque(100.0, percent);\n  return 0;\n}\n\n// Autonomous routine: three beanbags. main() shows the time report afterwards.\nint autonomousSequence()\n{\n  // BEANBAG 1\n  turnLeft(15.25);\n  driveDistance(forward, 95, 2000);\n  scoreBeanbag();\n  splitTimes[0] = Brain.Timer.time(seconds);\n\n  // BEANBAG 2\n  driveDistance(reverse, 40);\n  rebaseline();   // robot slid on the post\n  turnRight(15.5);\n  Intake.spin(forward);\n  driveDistance(forward, 50, 2000);\n  driveDistance(reverse, 75);\n  turnLeft(3);\n  wait(1.25,seconds);\n  Intake.stop(coast);\n  driveDistance(forward, 90, 2000, 15);\n  scoreBeanbag();\n  splitTimes[1] = Brain.Timer.time(seconds);\n\n  // BEANBAG 3\n  driveDistance(reverse, 50);\n  rebaseline();   // robot slid on the post\n  turnRight(16);\n  Intake.spin(forward);\n  driveDistance(forward, 80, 4000);\n  driveDistance(reverse, 80, 4000);\n  turnLeft(17);\n  wait(0.5,seconds);\n  Intake.stop(coast);\n  driveDistance(forward, 85, 2500);\n  scoreBeanbag();\n  splitTimes[2] = Brain.Timer.time(seconds);\n\n  runEndTime = splitTimes[2];\n  autonDone = true;\n  return 0;\n}\n\n// TouchLED press: only recorded here, and main() acts on it. Doing the work\n// in main() means two quick presses can never start two runs at once.\nvoid onevent_TouchLED_Pressed_0()\n{\n  pressPending = true;\n}\n\nint main() {\n  vexcodeInit();\n  whenStarted1();\n  TouchLED.pressed(onevent_TouchLED_Pressed_0);\n  // The brain calibrates the sensor by itself at startup; calibrating here\n  // too means the first run never starts on an uncalibrated sensor.\n  recalibrate();\n  int loops = 0;\n  while (true) {\n    if (state == STATE_RUNNING && autonDone) {\n      endRun();\n    }\n    if (pressPending) {\n      pressPending = false;\n      if (sinceStateChange.time(msec) >= PRESS_LOCKOUT_MS) {\n        if (state == STATE_READY) {\n          startRun();\n        } else if (state == STATE_RUNNING) {\n          endRun();\n        } else if (state == STATE_STOPPED) {\n          recalibrate();\n        }\n      }\n    }\n    if (showHeading && loops % 5 == 0) {\n      Brain.Screen.setCursor(2, 1);\n      Brain.Screen.print(\"Rot: %.1f   \", BrainInertial.rotation(degrees));\n    }\n    loops++;\n    wait(20, msec);\n  }\n}\n","textLanguage":"cpp","robotConfig":[{"port":[9,10,0],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"rev","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22},{"port":[12,7],"name":"Ratchet","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[8],"name":"TouchLED","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[1],"name":"Lift","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"Intake","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"Distance_Sensor","customName":true,"deviceType":"Distance","deviceClass":"sonar","setting":{},"triportSourcePort":22}],"slot":7,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}