{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor LeftDriveSmart = motor(PORT9, 1, true);\nmotor RightDriveSmart = motor(PORT10, 1, false);\ndrivetrain Drivetrain = drivetrain(LeftDriveSmart, RightDriveSmart, 200, 173, 76, mm, 1);\ncontroller Controller = controller();\nmotor RatchetMotorA = motor(PORT12, true);\nmotor RatchetMotorB = motor(PORT7, false);\nmotor_group Ratchet = motor_group(RatchetMotorA, RatchetMotorB);\n\ntouchled TouchLED = touchled(PORT8);\nmotor Lift = motor(PORT1, false);\nmotor Intake = motor(PORT6, true);\nsonar Distance_Sensor = sonar(PORT2);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool DrivetrainLNeedsToBeStopped_Controller = true;\nbool DrivetrainRNeedsToBeStopped_Controller = true;\n\n// define a task that will handle monitoring inputs from Controller\nint rc_auto_loop_function_Controller() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      \n      // calculate the drivetrain motor velocities from the controller joystick axies\n      // left = AxisA + AxisC\n      // right = AxisA - AxisC\n      int drivetrainLeftSideSpeed = Controller.AxisA.position() + Controller.AxisC.position();\n      int drivetrainRightSideSpeed = Controller.AxisA.position() - Controller.AxisC.position();\n      \n      // check if the value is inside of the deadband range\n      if (drivetrainLeftSideSpeed < 5 && drivetrainLeftSideSpeed > -5) {\n        // check if the left motor has already been stopped\n        if (DrivetrainLNeedsToBeStopped_Controller) {\n          // stop the left drive motor\n          LeftDriveSmart.stop();\n          // tell the code that the left motor has been stopped\n          DrivetrainLNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the left motor nexttime the input is in the deadband range\n        DrivetrainLNeedsToBeStopped_Controller = true;\n      }\n      // check if the value is inside of the deadband range\n      if (drivetrainRightSideSpeed < 5 && drivetrainRightSideSpeed > -5) {\n        // check if the right motor has already been stopped\n        if (DrivetrainRNeedsToBeStopped_Controller) {\n          // stop the right drive motor\n          RightDriveSmart.stop();\n          // tell the code that the right motor has been stopped\n          DrivetrainRNeedsToBeStopped_Controller = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the right motor next time the input is in the deadband range\n        DrivetrainRNeedsToBeStopped_Controller = true;\n      }\n      \n      // only tell the left drive motor to spin if the values are not in the deadband range\n      if (DrivetrainLNeedsToBeStopped_Controller) {\n        LeftDriveSmart.setVelocity(drivetrainLeftSideSpeed, percent);\n        LeftDriveSmart.spin(forward);\n      }\n      // only tell the right drive motor to spin if the values are not in the deadband range\n      if (DrivetrainRNeedsToBeStopped_Controller) {\n        RightDriveSmart.setVelocity(drivetrainRightSideSpeed, percent);\n        RightDriveSmart.spin(forward);\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n// LED behavior:\n//   blue   - calibrating, touch ignored\n//   green  - ready, touch to start\n//   orange - running, touch to stop IMMEDIATELY (no start lockout)\n//   red    - finished: touch to start again\n//            stopped with the TouchLED: touch to lower the lift and recalibrate\n// The joystick drives the robot while it is ready (green) or stopped (red\n// after a TouchLED stop), never during a run or while stopping.\n//\n// Joystick: the generated section above has its own joystick task (from the\n// Controller's drive setting in Devices). main() switches it off at startup\n// and reads the joystick itself, so nothing can drive the motors during a\n// run. Leave the generated section as VEXcode writes it.\n//\n// Run policy: every step does its best and the run always carries on, as the\n// original code did. A turn that doesn't settle, a drive that stops short or\n// a lift that misses its position is counted on the time report, never a\n// reason to stop. Only a TouchLED press stops a run.\n\nconst int LIFT_SCORE_POS = 730;        // degrees\nconst int LIFT_TIMEOUT_MS = 3000;\nconst double LIFT_POS_TOLERANCE = 20;  // degrees (tune on robot)\nconst double DRIVE_VELOCITY = 15;     // percent\nconst int DRIVE_DEFAULT_TIMEOUT_MS = 3000;\nconst double DRIVE_WHEEL_TRAVEL_MM = 200.0; // same as drivetrain configuration\n// A drive that ends further than this from its distance is counted as a miss.\nconst double DRIVE_DISTANCE_TOLERANCE_MM = 10.0; // tune on robot\n// Right after a non-blocking motor command, isDone() can still report the\n// previous (finished) move, so wait this long before polling it.\nconst int MOTION_START_MS = 50;\n\n// driveStraight() tuning. The structure (heading PD with a deadband, filtered\n// derivative, slew-limited speed and steering) follows driveDistanceMM() in\n// dd-vex-mix-match/state/DDStateAuto84Blue.iqcpp, plus a small integral so a\n// steadily weaker motor doesn't leave a lasting heading error. The numbers\n// were chosen in a simple simulation of this drivetrain (5-15% weaker motor,\n// motor and sensor lag) and still need tuning on the robot: if it wobbles,\n// lower KP; if it still curves, raise KP or KI.\n//\n// Steering is a FRACTION OF THE CURRENT SPEED: each wheel runs at\n// speed x (1 + steer) or speed x (1 - steer). The motors hold the speed they\n// are given, so a mismatch between the sides (wheel size, scrub, weight) is a\n// fixed fraction of the speed, and steering in the same form stays right as\n// the robot slows near the end. (A fixed % of motor power, tuned at full\n// speed, steered twice as hard at the slow end and turned the robot right.)\n// At 20% speed these equal 1.0% / 2.0% / 0.06% of motor power.\nconst double STRAIGHT_KP = 0.05;          // steering per degree off heading\nconst double STRAIGHT_KI = 0.10;          // steering per degree-second\nconst double STRAIGHT_KD = 0.003;         // steering per degree/second\nconst double STRAIGHT_DEADBAND_DEG = 0.5; // ignore heading errors below this\nconst double STRAIGHT_MAX_STEER = 0.30;   // most steering (wheels 0.7x to 1.3x)\nconst double STRAIGHT_STEER_SLEW = 0.06;  // most steering change per 10 ms\nconst double STRAIGHT_SPEED_SLEW = 2.5;   // most speed change per 10 ms (ramp)\nconst double STRAIGHT_SLOW_KP = 1.0;      // speed % per mm left (slows ~last 2 cm)\nconst double STRAIGHT_MIN_SPEED = 10;     // slowest speed while moving (%)\nconst double STRAIGHT_STOP_MM = 3;        // stop this close to the distance\n// After a drive (not a push), turn back if it ended further off its starting\n// heading than this. Compensates for the right side of the drive dragging.\nconst double STRAIGHT_SQUARE_DEG = 2.0;\n// The square-up turn runs at a steady slow speed and cuts the motors\n// SQUARE_LEAD_DEG before reaching the heading, because the robot keeps turning\n// a little after they stop; it doesn't correct afterwards (no back-and-forth).\n// Using the route turn controller instead slid 3 degrees past (ended left).\n// Tune SQUARE_LEAD_DEG from the report's n (+ = right): if n ends negative\n// (still too far left), make it bigger; if n ends positive, make it smaller.\nconst double SQUARE_SPEED = 12;           // turn speed, %\nconst double SQUARE_LEAD_DEG = 1.0;       // stop this many degrees early\nconst int SQUARE_TIMEOUT_MS = 1000;       // give up after this long\nconst int SQUARE_SETTLE_MS = 100;         // let it come to rest afterwards\n// driveStraight() first waits until the robot has stopped turning: the heading\n// changes less than STILL_DEG per 10 ms, 5 readings in a row (or STILL_MAX_MS\n// passes). A turn ends while the robot is still sliding, and a drive that\n// grabbed its heading mid-slide steered against the slide and ended turned.\nconst double STILL_DEG = 0.05;            // 5 degrees/second\nconst int STILL_MAX_MS = 500;\nconst int PRESS_LOCKOUT_MS = 500;    // applies to START / RECALIBRATE only\nconst double JOYSTICK_DEADBAND = 5;\n\n// NOTE: These settings intentionally preserve your original turn controller.\nconst bool HEADING_REVERSED = false;\nconst double TURN_KP = 1.2;\nconst double TURN_MIN_SPEED = 14;\nconst double TURN_MAX_SPEED = 20;\nconst double TURN_TOLERANCE = 1.5;\n// Very small turns use half the turn size as their tolerance (never less than\n// this), so a 1-degree turn doesn't start out already \"settled\".\nconst double TURN_FINE_TOLERANCE = 0.5;\nconst double TURN_KICK_SPEED = 30;\nconst int TURN_KICK_CYCLES = 1;      // one 10-ms control-loop iteration\nconst double TURN_KICK_MIN_ERROR = 8;\nconst int TURN_TIMEOUT_MS = 2500;\nconst double TURN_MAX_JUMP = 10;\nconst int TURN_GLITCH_ACCEPT = 5;\nconst double TURN_RUNAWAY_LIMIT = 30;\nconst bool TURN_DEBUG = true;\n// When true, rows 5-6 of the time report show the last driveStraight() call\n// instead of the turn details (see showTimeReport).\nconst bool STRAIGHT_DEBUG = true;\n\nenum RunState {\n  STATE_CALIBRATING,\n  STATE_READY,\n  STATE_RUNNING,\n  STATE_STOPPING,\n  STATE_STOPPED\n};\n\n// These variables are owned by main(), except where explicitly noted.\nRunState state = STATE_CALIBRATING;\ntimer sinceStateChange;\nbool lastTouchPressed = false;\nbool showHeading = false;\nbool leftManualActive = false;\nbool rightManualActive = false;\nbool stopWasRequested = false;\ndouble manualStopTime = 0;\nint loops = 0;\n\n// The worker writes the report fields. main() reads them ONLY after workerDone\n// has been published under runMutex, so it never reads a partial report.\ndouble splitTimes[3] = {0, 0, 0};\ndouble runEndTime = 0;\nint turnCount = 0;\nint glitchCount = 0;\nint bailCount = 0;\nint timeoutCount = 0;\nint driveMissCount = 0; // drives that ended short of their distance\nint liftMissCount = 0;  // lift moves that ended away from their target\n// The last driveStraight() call (STRAIGHT_DEBUG). Offsets are the heading\n// minus the heading it held, + = turned right.\ndouble sdHold = 0;                  // heading it held\ndouble sdMinOff = 0, sdMaxOff = 0;  // lowest / highest offset while driving\ndouble sdEndOff = 0;                // offset when it stopped\ndouble sdEndSteer = 0;              // steering when it stopped (+ = right)\ndouble sdEndSum = 0;                // integral (degree-seconds) when it stopped\ndouble sdLeftMm = 0, sdRightMm = 0; // how far each wheel rolled\ndouble dbgMin = 0, dbgMax = 0;\nint dbgFlips = 0, dbgMs = 0;\ndouble targetHeading = 0;\n\n// All access to these handshake flags MUST be protected by runMutex.\n// The same mutex also serializes cancellation with every worker motor START.\nmutex runMutex;\nbool runRequested = false;\nbool cancelRequested = false;\nbool workerDone = false;\n\nvoid setState(RunState s) {\n  state = s;\n  sinceStateChange.clear();\n}\n\nbool isCanceled() {\n  runMutex.lock();\n  bool canceled = cancelRequested;\n  runMutex.unlock();\n  return canceled;\n}\n\nbool isWorkerDone() {\n  runMutex.lock();\n  bool done = workerDone;\n  runMutex.unlock();\n  return done;\n}\n\n// CALL ONLY WHILE HOLDING runMutex.\nvoid stopAllMotorsLocked() {\n  Drivetrain.stop(brake);\n  // Brake avoids indefinite powered holding if the lift is against a hard stop.\n  // Use hold instead if the physical lift needs active holding against gravity.\n  Lift.stop(brake);\n  Intake.stop(coast);\n  Ratchet.stop(coast);\n}\n\n// Main uses this to request an immediate stop. A worker cannot submit a later\n// motor command: every motor command START is serialized with this lock.\nvoid cancelRun() {\n  runMutex.lock();\n  cancelRequested = true;\n  stopAllMotorsLocked();\n  runMutex.unlock();\n}\n\n// Worker side of that rule: locks runMutex and returns true, unless the run\n// has been cancelled, in which case it leaves the mutex unlocked and returns\n// false. Every worker motor command goes through this; unlock after issuing.\nbool lockUnlessCanceled() {\n  runMutex.lock();\n  if (cancelRequested) {\n    runMutex.unlock();\n    return false;\n  }\n  return true;\n}\n\nbool waitCancelable(int milliseconds) {\n  timer t;\n  t.clear();\n  while (t.time(msec) < milliseconds) {\n    if (isCanceled()) return false;\n    wait(10, msec);\n  }\n  return !isCanceled();\n}\n\n// Step helpers (liftTo, scoreBeanbag, turnLeft/turnRight, driveDistance,\n// startIntake/stopIntake): each does its best and returns, so the route\n// always carries on. Once the run is stopped with the TouchLED, each returns\n// at once without moving anything.\n\n// Moves the lift and waits for it. A lift that ends more than\n// LIFT_POS_TOLERANCE from its target (jammed, or resting on something) is\n// stopped and counted in liftMissCount.\nvoid liftTo(double positionDeg) {\n  if (!lockUnlessCanceled()) return;\n  Lift.setTimeout(LIFT_TIMEOUT_MS, msec);\n  Lift.spinToPosition(positionDeg, degrees, false);\n  runMutex.unlock();\n\n  timer t;\n  t.clear();\n  if (!waitCancelable(MOTION_START_MS)) return;\n  while (!Lift.isDone() && t.time(msec) < LIFT_TIMEOUT_MS + 150) {\n    if (isCanceled()) return;\n    wait(10, msec);\n  }\n  if (isCanceled()) return;\n\n  if (fabs(Lift.position(degrees) - positionDeg) > LIFT_POS_TOLERANCE) {\n    liftMissCount++;\n    if (!lockUnlessCanceled()) return;\n    Lift.stop(brake);\n    runMutex.unlock();\n  }\n}\n\n// Raises the lift to score, waits, and lowers it again. The lift is always\n// lowered, even if the raise missed.\nvoid scoreBeanbag() {\n  liftTo(LIFT_SCORE_POS);\n  waitCancelable(500);\n  liftTo(0);\n}\n\n// Called only when the robot is stopped, from main().\nbool zeroHeading() {\n  BrainInertial.setRotation(0, degrees);\n  wait(100, msec);\n  int tries = 0;\n  while (tries < 40 && fabs(BrainInertial.rotation(degrees)) > 1.0) {\n    wait(25, msec);\n    tries++;\n  }\n  return !BrainInertial.isCalibrating() &&\n         fabs(BrainInertial.rotation(degrees)) <= 1.0;\n}\n\n// One rotation reading, signed so that a right turn is positive.\ndouble rawHeading() {\n  return (HEADING_REVERSED ? -1.0 : 1.0) * BrainInertial.rotation(degrees);\n}\n\n// The middle of three readings 5 ms apart, so a single glitched reading can't\n// become the reference that a turn is measured from.\ndouble steadyHeading() {\n  double a = rawHeading();\n  wait(5, msec);\n  double b = rawHeading();\n  wait(5, msec);\n  double c = rawHeading();\n  if ((a <= b && b <= c) || (c <= b && b <= a)) return b;\n  if ((b <= a && a <= c) || (c <= a && a <= b)) return a;\n  return c;\n}\n\n// Tolerance for a turn of 'deg' degrees: TURN_TOLERANCE normally, but half\n// the turn size for very small turns (never below TURN_FINE_TOLERANCE).\ndouble turnTolerance(double deg) {\n  double tolerance = fabs(deg) / 2;\n  if (tolerance > TURN_TOLERANCE) tolerance = TURN_TOLERANCE;\n  if (tolerance < TURN_FINE_TOLERANCE) tolerance = TURN_FINE_TOLERANCE;\n  return tolerance;\n}\n\n// Turns to targetHeading, slowing as it gets close. A turn that runs out of\n// time is counted in timeoutCount; one that runs away (the error grows\n// TURN_RUNAWAY_LIMIT past where it started) is stopped and counted in\n// bailCount. Either way the route carries on from wherever the robot ended.\nvoid turnToTarget(double tolerance) {\n  if (isCanceled()) return;\n  bool logThis = (turnCount == 0);\n  turnCount++;\n  timer t;\n  t.clear();\n  int settled = 0;\n  int lastDir = 0;\n  int badCount = 0;\n  int cycles = 0;\n  bool bailed = false;\n  double lastGood = steadyHeading();\n  double startError = fabs(targetHeading - lastGood);\n  double error = targetHeading - lastGood;\n  if (logThis) {\n    dbgMin = dbgMax = lastGood;\n    dbgFlips = 0;\n  }\n\n  while (t.time(msec) < TURN_TIMEOUT_MS && settled < 5) {\n    double raw = rawHeading();\n    double rot;\n    if (fabs(raw - lastGood) > TURN_MAX_JUMP && badCount < TURN_GLITCH_ACCEPT) {\n      badCount++;\n      glitchCount++;\n      rot = lastGood;\n    } else {\n      badCount = 0;\n      rot = raw;\n      lastGood = raw;\n    }\n\n    error = targetHeading - rot;\n    if (logThis) {\n      if (rot < dbgMin) dbgMin = rot;\n      if (rot > dbgMax) dbgMax = rot;\n    }\n    if (fabs(error) > startError + TURN_RUNAWAY_LIMIT) {\n      bailCount++;\n      bailed = true;\n      break;\n    }\n\n    if (!lockUnlessCanceled()) return;\n    if (fabs(error) <= tolerance) {\n      Drivetrain.stop(brake);\n      settled++;\n    } else {\n      settled = 0;\n      int dir = (error > 0) ? 1 : -1;\n      if (logThis && lastDir != 0 && dir != lastDir) dbgFlips++;\n      lastDir = dir;\n      double speed = fabs(error) * TURN_KP;\n      if (speed < TURN_MIN_SPEED) speed = TURN_MIN_SPEED;\n      if (speed > TURN_MAX_SPEED) speed = TURN_MAX_SPEED;\n      if (cycles < TURN_KICK_CYCLES &&\n          fabs(error) > TURN_KICK_MIN_ERROR && speed < TURN_KICK_SPEED) {\n        speed = TURN_KICK_SPEED;\n      }\n      Drivetrain.setTurnVelocity(speed, percent);\n      Drivetrain.turn(dir > 0 ? right : left);\n    }\n    runMutex.unlock();\n    cycles++;\n    wait(10, msec);\n  }\n\n  if (logThis) dbgMs = (int)t.time(msec);\n  if (!lockUnlessCanceled()) return;\n  Drivetrain.stop(brake);\n  runMutex.unlock();\n  if (settled < 5 && !bailed) timeoutCount++;\n}\n\n// Makes the robot's current real heading the new reference, after it rams a\n// post and slides.\nvoid rebaseline() {\n  targetHeading = steadyHeading();\n}\n\nvoid turnLeft(double deg) {\n  targetHeading -= deg;\n  turnToTarget(turnTolerance(deg));\n}\n\nvoid turnRight(double deg) {\n  targetHeading += deg;\n  turnToTarget(turnTolerance(deg));\n}\n\ndouble clampValue(double v, double lo, double hi) {\n  if (v < lo) return lo;\n  if (v > hi) return hi;\n  return v;\n}\n\n// Moves 'current' toward 'target' by at most maxStep.\ndouble slewToward(double target, double current, double maxStep) {\n  return current + clampValue(target - current, -maxStep, maxStep);\n}\n\n// How far (mm) a drive wheel has rolled since its motor read startDeg.\ndouble wheelTravelMm(motor& m, double startDeg) {\n  return fabs(m.position(degrees) - startDeg) * DRIVE_WHEEL_TRAVEL_MM / 360.0;\n}\n\n// Counts a drive in driveMissCount if either wheel ended further than\n// DRIVE_DISTANCE_TOLERANCE_MM short of distMm (each wheel is checked, since\n// the average could hide a stuck motor).\nvoid countDriveMiss(double distMm, double startL, double startR) {\n  double shortest = fmin(wheelTravelMm(LeftDriveSmart, startL),\n                         wheelTravelMm(RightDriveSmart, startR));\n  if (shortest < distMm - DRIVE_DISTANCE_TOLERANCE_MM) driveMissCount++;\n}\n\n// Drives a distance and waits for it, using the non-blocking driveFor() and\n// polling isDone(); the drive gives up after timeoutMs. 'allowContact' is for\n// timed pushes into a post: ending at the timeout is expected there, so the\n// distance isn't checked. Otherwise a drive that ends short is counted (see\n// countDriveMiss). A call with an impossible distance, speed or timeout is\n// skipped and counted the same way.\n// void driveDistance(directionType dir, double distMm,\n//                    int timeoutMs = DRIVE_DEFAULT_TIMEOUT_MS,\n//                    double velocityPct = DRIVE_VELOCITY,\n//                    bool allowContact = false) {\n//   if (timeoutMs <= 0 || distMm <= 0 || velocityPct <= 0 || velocityPct > 100) {\n//     driveMissCount++;\n//     return;\n//   }\n\n//   if (!lockUnlessCanceled()) return;\n//   double startL = LeftDriveSmart.position(degrees);\n//   double startR = RightDriveSmart.position(degrees);\n//   Drivetrain.setDriveVelocity(velocityPct, percent);\n//   Drivetrain.setTimeout(timeoutMs, msec); // documented positive timeout\n//   Drivetrain.driveFor(dir, distMm, mm, false);\n//   runMutex.unlock();\n\n//   timer t;\n//   t.clear();\n//   if (!waitCancelable(MOTION_START_MS)) return;\n//   while (!Drivetrain.isDone() && t.time(msec) < timeoutMs + 150) {\n//     if (isCanceled()) return;\n//     wait(10, msec);\n//   }\n//   if (isCanceled()) return;\n\n//   // Past the time limit and still moving: don't leave the motors running.\n//   if (!Drivetrain.isDone()) {\n//     if (!lockUnlessCanceled()) return;\n//     Drivetrain.stop(brake);\n//     runMutex.unlock();\n//   }\n//   if (allowContact) return;\n//   countDriveMiss(distMm, startL, startR);\n// }\n\n// Waits until the robot has stopped turning (see STILL_DEG), at most\n// STILL_MAX_MS. Returns at once after a TouchLED stop.\nvoid waitUntilStill() {\n  timer t;\n  t.clear();\n  double last = rawHeading();\n  int stillCount = 0;\n  while (stillCount < 5 && t.time(msec) < STILL_MAX_MS) {\n    if (isCanceled()) return;\n    wait(10, msec);\n    double now = rawHeading();\n    if (fabs(now - last) < STILL_DEG) stillCount++;\n    else stillCount = 0;\n    last = now;\n  }\n}\n\n// Turns the robot back toward 'heading' if it is more than\n// STRAIGHT_SQUARE_DEG off it: a steady SQUARE_SPEED turn that stops\n// SQUARE_LEAD_DEG early with the motors holding, then lets the robot settle.\n// Doesn't touch the route's targetHeading.\nvoid squareUpTo(double heading) {\n  double offset = steadyHeading() - heading;  // + = right of the heading\n  if (fabs(offset) <= STRAIGHT_SQUARE_DEG) return;\n  double side = (offset > 0) ? 1.0 : -1.0;\n  if (!lockUnlessCanceled()) return;\n  Drivetrain.setTurnVelocity(SQUARE_SPEED, percent);\n  Drivetrain.turn(offset > 0 ? left : right);\n  runMutex.unlock();\n\n  timer t;\n  t.clear();\n  while (t.time(msec) < SQUARE_TIMEOUT_MS) {\n    double toGo = (rawHeading() - heading) * side;  // degrees still to turn\n    if (toGo <= SQUARE_LEAD_DEG) break;\n    if (isCanceled()) return;\n    wait(10, msec);\n  }\n  if (!lockUnlessCanceled()) return;\n  Drivetrain.stop(hold);\n  runMutex.unlock();\n  waitCancelable(SQUARE_SETTLE_MS);\n}\n\n// Drives a distance in a straight line, holding the heading the robot had\n// when it started. A PID loop on the inertial sensor speeds up one wheel and\n// slows the other to steer back onto that heading. The speed ramps up at the\n// start and slows over the last few cm. Same arguments and miss counting as\n// driveDistance(): it gives up after timeoutMs, and 'allowContact' is for\n// timed pushes into a post (distance isn't checked). Except after a push,\n// it then squares up: if the robot ended more than STRAIGHT_SQUARE_DEG off\n// its starting heading (the right side of this robot drags), it turns back.\n// After a push it doesn't, since turning against the post would twist the\n// robot on it. Returns at once after a TouchLED stop.\nvoid driveStraight(directionType dir, double distMm,\n                   int timeoutMs = DRIVE_DEFAULT_TIMEOUT_MS,\n                   double velocityPct = DRIVE_VELOCITY,\n                   bool allowContact = false) {\n  if (timeoutMs <= 0 || distMm <= 0 || velocityPct <= 0 || velocityPct > 100) {\n    driveMissCount++;\n    return;\n  }\n  if (isCanceled()) return;\n\n  waitUntilStill();  // e.g. a turn just before may still be sliding\n  if (isCanceled()) return;\n  const double holdHeading = steadyHeading();\n  const double startL = LeftDriveSmart.position(degrees);\n  const double startR = RightDriveSmart.position(degrees);\n  // Backing up, the same steering has to go to the other wheel.\n  const double steerSign = (dir == forward) ? 1.0 : -1.0;\n  const double minSpeed = fmin(STRAIGHT_MIN_SPEED, velocityPct);\n  double speed = 0;\n  double steer = 0;\n  double lastError = 0;\n  double errorRate = 0;  // filtered, degrees/second\n  double errorSum = 0;   // degree-seconds, capped so KI alone can't exceed max\n  const double maxErrorSum = STRAIGHT_MAX_STEER / STRAIGHT_KI;\n  sdHold = holdHeading;\n  sdMinOff = sdMaxOff = sdEndOff = sdEndSteer = sdEndSum = 0;\n  sdLeftMm = sdRightMm = 0;\n  timer t;\n  t.clear();\n\n  while (t.time(msec) < timeoutMs) {\n    double travelled = (wheelTravelMm(LeftDriveSmart, startL) +\n                        wheelTravelMm(RightDriveSmart, startR)) / 2;\n    double remaining = distMm - travelled;\n    if (remaining <= STRAIGHT_STOP_MM) break;\n\n    // Speed: velocityPct, slowing over the last few cm, changed gradually.\n    double targetSpeed =\n        clampValue(remaining * STRAIGHT_SLOW_KP, minSpeed, velocityPct);\n    speed = slewToward(targetSpeed, speed, STRAIGHT_SPEED_SLEW);\n\n    // Steering: error > 0 means the robot has turned left of the heading.\n    double offset = rawHeading() - holdHeading;  // + = turned right\n    if (offset < sdMinOff) sdMinOff = offset;\n    if (offset > sdMaxOff) sdMaxOff = offset;\n    double error = -offset;\n    if (fabs(error) < STRAIGHT_DEADBAND_DEG) error = 0;\n    errorRate = 0.75 * errorRate + 0.25 * (error - lastError) / 0.010;\n    lastError = error;\n    errorSum = clampValue(errorSum + error * 0.010, -maxErrorSum, maxErrorSum);\n    double wanted = (STRAIGHT_KP * error + STRAIGHT_KI * errorSum +\n                     STRAIGHT_KD * errorRate) * steerSign;\n    steer = slewToward(\n        clampValue(wanted, -STRAIGHT_MAX_STEER, STRAIGHT_MAX_STEER), steer,\n        STRAIGHT_STEER_SLEW);\n\n    if (!lockUnlessCanceled()) return;\n    LeftDriveSmart.spin(dir, speed * (1 + steer), percent);\n    RightDriveSmart.spin(dir, speed * (1 - steer), percent);\n    runMutex.unlock();\n    wait(10, msec);\n  }\n\n  sdEndOff = rawHeading() - holdHeading;\n  sdEndSteer = steer;\n  sdEndSum = errorSum;\n  if (!lockUnlessCanceled()) return;\n  Drivetrain.stop(brake);\n  runMutex.unlock();\n  sdLeftMm = wheelTravelMm(LeftDriveSmart, startL);\n  sdRightMm = wheelTravelMm(RightDriveSmart, startR);\n  if (allowContact) return;\n  countDriveMiss(distMm, startL, startR);\n\n}\n\n// Intakes are issued under the same cancellation/motor-command mutex.\nvoid startIntake() {\n  if (!lockUnlessCanceled()) return;\n  Intake.spin(forward);\n  runMutex.unlock();\n}\n\nvoid stopIntake() {\n  if (!lockUnlessCanceled()) return;\n  Intake.stop(coast);\n  runMutex.unlock();\n}\n\n// The route: same distances, speeds, waits and commented-out third scoring\n// steps as the original. Every step always carries on to the next. After a\n// TouchLED stop the remaining steps return at once, so the split times are\n// only recorded if the run is still going.\nvoid autonomousSequence() {\n  // BEANBAG 1\n  turnLeft(15.35);\n  driveStraight(forward, 95, 2000, DRIVE_VELOCITY, true);  // push into post\n  scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[0] = Brain.Timer.time(seconds);\n\n  // BEANBAG 2\n  driveStraight(reverse, 40);\n  rebaseline();  // robot slid on the post\n  turnRight(17);\n  startIntake();\n  driveStraight(forward, 50, 2000, DRIVE_VELOCITY, true);  // pick up beanbag\n  driveStraight(reverse, 75);\n  turnLeft(1);\n  waitCancelable(1250);\n  stopIntake();\n  driveStraight(forward, 90, 2000, 15, true);  // push into post\n  scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[1] = Brain.Timer.time(seconds);\n\n  // BEANBAG 3 - left intentionally unchanged / incomplete as requested.\n  driveStraight(reverse, 50);\n  rebaseline();  // robot slid on the post\n  turnRight(30);\n  startIntake();\n  driveStraight(forward, 110, 4000, DRIVE_VELOCITY, true);  // pick up beanbag\n  driveStraight(reverse, 80, 4000);\n  turnLeft(30);\n  wait(0.5,seconds);\n  Intake.stop(coast);\n  // driveDistance(forward, 85, 2500);\n  // scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[2] = Brain.Timer.time(seconds);\n  runEndTime = splitTimes[2];\n}\n\n\nvoid test_autonomousSequence() {\n  // BEANBAG 1\n  turnLeft(21.0);\n  wait(0.5,sec);\n  // // Open-floor test, so not a push (false): it squares up at the end.\n  driveStraight(forward, 95, 6000, 14.0, false);\n  wait(0.2,sec);\n  scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[0] = Brain.Timer.time(seconds);\n\n  // BEANBAG 2\n  driveStraight(reverse, 40, 4000, 14.0, false);\n  wait(0.5,sec);\n  \n  // rebaseline();  // robot slid on the post\n  turnRight(6.0);\n  wait(0.5,sec);\n  startIntake();\n  driveStraight(forward, 55, 2000, 14.0, true);  // pick up beanbag\n  wait(0.5, seconds);\n  driveStraight(reverse, 75, 4000, 14.0, false);\n  wait(0.5, seconds);\n  turnLeft(7.0);\n  wait(0.5,seconds);\n  // waitCancelable(1250);\n  stopIntake();\n  driveStraight(forward, 90, 2000, 14.0, true);  // push into post\n  scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[1] = Brain.Timer.time(seconds);\n\n  // BEANBAG 3 - left intentionally unchanged / incomplete as requested.\n  driveStraight(reverse, 50, 2000, 14.0, false);\n  wait(0.2,seconds);\n  // rebaseline();  // robot slid on the post\n  turnRight(40.0);\n  wait(0.5,seconds);\n  startIntake();\n  driveStraight(forward, 105, 4000, 14.0, false);  // pick up beanbag\n  wait(0.2,seconds);\n  driveStraight(reverse, 110, 4000);\n  wait(0.5,seconds);\n  turnLeft(30);\n  wait(0.5,seconds);\n  Intake.stop(coast);\n  driveStraight(forward, 85, 2500, 14.0, true);\n  scoreBeanbag();\n  if (isCanceled()) return;\n  splitTimes[2] = Brain.Timer.time(seconds);\n  runEndTime = splitTimes[2];\n}\n\n// Created ONCE from main(). Never forcibly kill a task while it holds a mutex.\n// Instead cancel cooperatively and stop the motors immediately in main().\nint autonomousWorker() {\n  while (true) {\n    runMutex.lock();\n    bool start = runRequested;\n    if (start) runRequested = false;\n    runMutex.unlock();\n\n    if (!start) {\n      wait(10, msec);\n      continue;\n    }\n\n    // autonomousSequence();\n    test_autonomousSequence();\n    runMutex.lock();\n    stopAllMotorsLocked();\n    workerDone = true; // publish all completed worker-written report fields\n    runMutex.unlock();\n  }\n  return 0;\n}\n\nvoid printSplit(int row, const char* label, double t) {\n  Brain.Screen.setCursor(row, 1);\n  if (t > 0) Brain.Screen.print(\"%s %.2f s\", label, t);\n  else Brain.Screen.print(\"%s --\", label);\n}\n\nvoid showTimeReport(double total, bool manualStop) {\n  Brain.Screen.setFont(mono15);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Total: %.2f s\", total);\n  printSplit(2, \"BB1:\", splitTimes[0]);\n  printSplit(3, \"BB2:\", splitTimes[1]);\n  printSplit(4, \"BB3:\", splitTimes[2]);\n  if (STRAIGHT_DEBUG) {\n    // Last driveStraight(), degrees, + = turned right of the held heading:\n    //   row 5: lowest..highest while driving, e = when it stopped\n    //   row 6: n = now (robot at rest, so n - e = what the stop itself did),\n    //          s = steering at the stop (+ = right), i = integral (deg-s)\n    //   row 7: after DONE / CANCELLED, left / right wheel travel in mm\n    Brain.Screen.setCursor(5, 1);\n    Brain.Screen.print(\"%.1f..%.1f e%+.1f\", sdMinOff, sdMaxOff, sdEndOff);\n    Brain.Screen.setCursor(6, 1);\n    Brain.Screen.print(\"n%+.1f s%+.2f i%+.1f\", rawHeading() - sdHold,\n                       sdEndSteer, sdEndSum);\n  } else if (TURN_DEBUG) {\n    Brain.Screen.setCursor(5, 1);\n    Brain.Screen.print(\"T1:%.0f/%.0f %d\", dbgMin, dbgMax, dbgMs);\n    // f = direction flips in turn 1, g = sensor glitches ignored,\n    // b = runaway turns, t = turn timeouts, d = short drives, l = lift misses\n    Brain.Screen.setCursor(6, 1);\n    Brain.Screen.print(\"f%d g%d b%d t%d d%d l%d\", dbgFlips, glitchCount,\n                       bailCount, timeoutCount, driveMissCount, liftMissCount);\n  }\n  Brain.Screen.setCursor(7, 1);\n  Brain.Screen.print(manualStop ? \"CANCELLED\" : \"DONE\");\n  if (STRAIGHT_DEBUG) Brain.Screen.print(\" %.0f/%.0f\", sdLeftMm, sdRightMm);\n}\n\nvoid showReadyScreen() {\n  Brain.Screen.setFont(mono20);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Batt: %d%%\", (int)Brain.Battery.capacity(percent));\n}\n\n// Lets the drive wheels turn freely (coast), so the robot can be pushed by\n// hand between runs. Runs and the TouchLED stop still brake, to stop quickly.\nvoid releaseDrive() {\n  Drivetrain.stop(coast);\n}\n\nvoid becomeReady() {\n  releaseDrive();\n  showReadyScreen();\n  showHeading = true;\n  leftManualActive = rightManualActive = false;\n  TouchLED.setColor(green);\n  setState(STATE_READY);\n  // Ignore any touch held through the blocking calibration procedure.\n  lastTouchPressed = TouchLED.pressing();\n}\n\nvoid showCalibrationFailure() {\n  releaseDrive();\n  showHeading = false;\n  Brain.Screen.setFont(mono20);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n  Brain.Screen.print(\"Inertial error\");\n  Brain.Screen.setCursor(2, 1);\n  Brain.Screen.print(\"Press to retry\");\n  TouchLED.setColor(red);\n  setState(STATE_STOPPED);\n  lastTouchPressed = TouchLED.pressing();\n}\n\n// This is called from main only when no autonomous run is in flight.\nvoid recalibrate() {\n  setState(STATE_CALIBRATING);\n  leftManualActive = rightManualActive = false;\n  Drivetrain.stop(brake);\n  showHeading = false;\n  TouchLED.setColor(blue);\n  // A cancelled run leaves the lift braked wherever it stopped. Lower it now,\n  // before the robot has to stay still for calibration. The lift's timeout\n  // (LIFT_TIMEOUT_MS) stops this if the lift is jammed.\n  if (Lift.position(degrees) > LIFT_POS_TOLERANCE) {\n    Lift.spinToPosition(0, degrees, true);\n  }\n  wait(200, msec);\n  BrainInertial.calibrate();\n  while (BrainInertial.isCalibrating()) wait(25, msec);\n  if (!zeroHeading()) {\n    showCalibrationFailure();\n    return;\n  }\n  becomeReady();\n}\n\n// The joystick drives ONLY from main, in STATE_READY or STATE_STOPPED. The\n// generated joystick task is switched off at startup, so nothing can drive\n// the motors during a run.\nvoid manualMotor(motor& m, double speed, bool& previouslyActive) {\n  if (fabs(speed) < JOYSTICK_DEADBAND) {\n    if (previouslyActive) m.stop(coast);  // free to push by hand afterwards\n    previouslyActive = false;\n  } else {\n    m.spin(speed >= 0 ? forward : reverse, fabs(speed), percent);\n    previouslyActive = true;\n  }\n}\n\nvoid updateManualDrive() {\n  double l = Controller.AxisA.position() + Controller.AxisC.position();\n  double r = Controller.AxisA.position() - Controller.AxisC.position();\n  double maximum = fmax(fabs(l), fabs(r));\n  if (maximum > 100.0) {\n    l *= 100.0 / maximum;\n    r *= 100.0 / maximum;\n  }\n  manualMotor(LeftDriveSmart, l, leftManualActive);\n  manualMotor(RightDriveSmart, r, rightManualActive);\n}\n\nvoid startRun() {\n  // main is the only thread that can operate the joystick; it stops here.\n  Drivetrain.stop(brake);\n  leftManualActive = rightManualActive = false;\n  showHeading = false;\n  TouchLED.setColor(orange);\n\n  // This occurs BEFORE the worker starts, so resets do not race its writes.\n  splitTimes[0] = splitTimes[1] = splitTimes[2] = 0;\n  turnCount = glitchCount = bailCount = timeoutCount = 0;\n  driveMissCount = liftMissCount = 0;\n  sdHold = sdMinOff = sdMaxOff = sdEndOff = sdEndSteer = sdEndSum = 0;\n  sdLeftMm = sdRightMm = 0;\n  dbgMin = dbgMax = 0;\n  dbgFlips = dbgMs = 0;\n  runEndTime = 0;\n  stopWasRequested = false;\n  manualStopTime = 0;\n\n  // Start even if zeroing didn't fully take: turns are measured from wherever\n  // the sensor really is, so the run doesn't depend on it reading exactly 0.\n  zeroHeading();\n  targetHeading = steadyHeading();\n  Brain.Timer.clear();\n  setState(STATE_RUNNING);\n  lastTouchPressed = TouchLED.pressing();\n\n  runMutex.lock();\n  cancelRequested = false;\n  workerDone = false;\n  runRequested = true;\n  runMutex.unlock();\n}\n\nvoid requestStop() {\n  if (state != STATE_RUNNING) return;\n  manualStopTime = Brain.Timer.time(seconds);\n  stopWasRequested = true;\n  setState(STATE_STOPPING);\n  cancelRun(); // stops motors now, even if worker is inside a drive/lift command\n}\n\nvoid finishRun() {\n  // Must only be called after isWorkerDone(); all worker data is now stable.\n  showHeading = false;\n  double total = stopWasRequested ? manualStopTime : runEndTime;\n  showTimeReport(total, stopWasRequested);\n  TouchLED.setColor(red);\n  leftManualActive = rightManualActive = false;\n  // The worker braked the drive when the run ended; give it a moment to come\n  // to a full stop (it may have been moving fast on a TouchLED stop), then\n  // let the wheels turn freely.\n  wait(250, msec);\n  releaseDrive();\n  // A finished run can be restarted straight away (after the lockout). A run\n  // stopped with the TouchLED must be recalibrated first.\n  setState(stopWasRequested ? STATE_STOPPED : STATE_READY);\n}\n\nvoid configureRobot() {\n  LeftDriveSmart.setMaxTorque(100, percent);\n  RightDriveSmart.setMaxTorque(100, percent);\n  Drivetrain.setStopping(brake);\n  Lift.setStopping(brake);\n  Intake.setStopping(coast);\n  Ratchet.setStopping(coast);\n  Drivetrain.setDriveVelocity(DRIVE_VELOCITY, percent);\n  Drivetrain.setTurnVelocity(50, percent);\n  Ratchet.setVelocity(100, percent);\n  Ratchet.setMaxTorque(100, percent);\n  Lift.setVelocity(100, percent);\n  Lift.setMaxTorque(100, percent);\n  Lift.setPosition(0, degrees); // assumes the physical lift starts at zero\n  Lift.setTimeout(LIFT_TIMEOUT_MS, msec);\n  Intake.setVelocity(100, percent);\n  Intake.setMaxTorque(100, percent);\n}\n\nint main() {\n  // Switch off the generated joystick task first: main() reads the joystick\n  // itself, and only while no run is in flight.\n  RemoteControlCodeEnabled = false;\n  vexcodeInit();\n  configureRobot();\n  // Create the worker after hardware configuration (not during globals init).\n  task worker(autonomousWorker);\n  recalibrate();\n\n  while (true) {\n    if ((state == STATE_RUNNING || state == STATE_STOPPING) &&\n        isWorkerDone()) {\n      finishRun();\n    }\n\n    // Poll instead of a concurrent TouchLED callback: there is no shared\n    // pressPending flag and no read/clear race. Detect one event per press.\n    bool pressedNow = TouchLED.pressing();\n    bool newPress = pressedNow && !lastTouchPressed;\n    lastTouchPressed = pressedNow;\n    if (newPress) {\n      if (state == STATE_RUNNING) {\n        requestStop(); // No lockout: emergency stop always takes priority.\n      } else if (sinceStateChange.time(msec) >= PRESS_LOCKOUT_MS) {\n        if (state == STATE_READY) startRun();\n        else if (state == STATE_STOPPED) recalibrate();\n      }\n    }\n\n    // STOPPED is after the worker has finished, so the driver can bring the\n    // robot back after a TouchLED stop (or a sensor error) before recalibrating.\n    if (state == STATE_READY || state == STATE_STOPPED) updateManualDrive();\n\n    if (showHeading && (loops % 5 == 0)) {\n      Brain.Screen.setCursor(2, 1);\n      Brain.Screen.print(\"Rot: %.1f   \", BrainInertial.rotation(degrees));\n    }\n    loops++;\n    wait(20, msec);\n  }\n}\n","textLanguage":"cpp","robotConfig":[{"port":[9,10,0],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"rev","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22},{"port":[12,7],"name":"Ratchet","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[8],"name":"TouchLED","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[1],"name":"Lift","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"Intake","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"Distance_Sensor","customName":true,"deviceType":"Distance","deviceClass":"sonar","setting":{},"triportSourcePort":22}],"slot":7,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}